[
  {
    "context": "Workspace",
    "bindings": {}
  },
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "g h": "pane::ActivatePreviousItem",
      "g l": "pane::ActivateNextItem",
      "ctrl-s": "workspace::SaveAll"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-s": [
        "workspace::SendKeystrokes",
        "escape : w a enter"
      ]
    }
  },
  {
    "context": "vim_mode == insert",
    "bindings": {
      "ctrl-space": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "vim_mode == insert",
    "unbind": {
      "ctrl-s": "editor::ShowSignatureHelp"
    }
  },
  {
    "context": "vim_mode == normal && extension == bake",
    "bindings": {
      "space r": [
        "task::Spawn",
        {
          "task_name": "Update recipe"
        }
      ]
    }
  }
]
